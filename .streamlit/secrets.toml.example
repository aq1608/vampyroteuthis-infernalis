# Streamlit secrets template.
#
# LOCAL: copy this file to `.streamlit/secrets.toml` and fill in your key.
# STREAMLIT CLOUD: paste the contents (without this comment) into
#   App settings -> Secrets, in the dashboard.
#
# Never commit the real secrets.toml - it is gitignored.

GEMINI_API_KEY = "your_gemini_api_key_here"

# Optional: enable the live shared leaderboard (see supabase_schema.sql).
# Use the project URL and the public "anon" key (safe for client use with RLS).
# Leave these out to fall back to the offline code-passing leaderboard.
# SUPABASE_URL = "https://your-project.supabase.co"
# SUPABASE_KEY = "your_supabase_anon_key"
